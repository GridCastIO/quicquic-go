tracepoint:sched:sched_switch
{
  $c = cpu;
  if ($c == 4 || $c == 5 || ($c >= 8 && $c <= 15) || $c == 20 || $c == 21 || ($c >= 24 && $c <= 31)) {
    if (@ts[$c] != 0) {
      @rt[$c, args.prev_comm, args.prev_pid] = sum(nsecs - @ts[$c]);
    }
    @ts[$c] = nsecs;
    @sw[$c] = count();
  }
}
END { clear(@ts); }
