@@ -0,0 +1,134 @@
+package worktreeplacement_test
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	gitutil "github.com/the-sarge/ras/internal/git"
+	"github.com/the-sarge/ras/internal/store"
+	"github.com/the-sarge/ras/internal/worktreeplacement"
+)
+
+func TestConfiguredReviewAndVerifyUseTaskRepositoryLayout(t *testing.T) {
+	st, repo, root := database(t), repository(t), t.TempDir()
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"review", "verify", "implement", "review-loop", "consider-resolve"} {
+		t.Run(kind, func(t *testing.T) {
+			spec := worktreeplacement.Spec{Root: root, SourceRepo: repo, RepoIdentity: "the-sarge/quic-go-fast", Kind: kind, OwnerID: "owner", ExecutionID: "execution", Slot: "agent"}
+			path, err := preparePath(t.Context(), st, spec)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rel, err := filepath.Rel(canonical, path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			parts := strings.Split(rel, string(filepath.Separator))
+			if kind == "review" || kind == "verify" {
+				if len(parts) != 2 || parts[1] != "quic-go-fast" || !strings.HasPrefix(parts[0], "ras-"+kind+"-agent-") || len(parts[0]) > 65 {
+					t.Fatalf("expected task/repository layout, got %s", rel)
+				}
+			} else if len(parts) != 3 || !strings.HasPrefix(parts[0], "quic-go-fast-") || !strings.HasPrefix(parts[2], "agent-") {
+				t.Fatalf("non-review layout changed: %s", rel)
+			}
+		})
+	}
+}
+
+func TestReviewLayoutPreservesRecordedAndLegacyPaths(t *testing.T) {
+	st, repo, root := database(t), repository(t), t.TempDir()
+	canonical, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldPath := filepath.Join(canonical, "old-repository-group", "old-execution", "old-agent")
+	spec := worktreeplacement.Spec{SourceRepo: repo, Kind: "review", OwnerID: "owner", ExecutionID: "old", Slot: "agent", LegacyPath: oldPath}
+	if path, err := preparePath(t.Context(), st, spec); err != nil || path != oldPath {
+		t.Fatalf("legacy path = %s, %v", path, err)
+	}
+	if _, err := os.Stat(filepath.Dir(oldPath)); !os.IsNotExist(err) {
+		t.Fatalf("legacy preparation materialized storage: %v", err)
+	}
+	common, err := gitutil.CommonDir(t.Context(), repo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	common, err = filepath.EvalSymlinks(common)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := st.ReserveWorktreeLocation(store.WorktreeLocation{Kind: spec.Kind, OwnerID: spec.OwnerID, ExecutionID: spec.ExecutionID, Slot: spec.Slot, Path: oldPath, SourceRepo: repo, CommonDir: common}); err != nil {
+		t.Fatal(err)
+	}
+	if err := gitutil.AddWorktree(t.Context(), repo, oldPath, "HEAD"); err != nil {
+		t.Fatal(err)
+	}
+	if err := worktreeplacement.Created(t.Context(), st, oldPath); err != nil {
+		t.Fatal(err)
+	}
+	spec.Root = filepath.Join(canonical, "unavailable-new-root")
+	if path, err := preparePath(t.Context(), st, spec); err != nil || path != oldPath {
+		t.Fatalf("recorded old layout = %s, %v", path, err)
+	}
+	otherOwner := spec
+	otherOwner.OwnerID = "different-owner"
+	if _, err := preparePath(t.Context(), st, otherOwner); err == nil {
+		t.Fatal("recorded owner mismatch accepted")
+	}
+	if _, err := worktreeplacement.Remove(t.Context(), st, repo, oldPath); err != nil {
+		t.Fatal(err)
+	}
+	if err := worktreeplacement.CanReconcileMissing(t.Context(), st, repo, oldPath); err != nil {
+		t.Fatalf("removed old layout no longer reconciles: %v", err)
+	}
+}
+
+func TestReviewTaskCleanupPreservesUnownedSibling(t *testing.T) {
+	for _, kind := range []string{"review", "verify"} {
+		t.Run(kind, func(t *testing.T) {
+			st, repo := database(t), repository(t)
+			spec := worktreeplacement.Spec{Root: t.TempDir(), SourceRepo: repo, Kind: kind, OwnerID: "owner", ExecutionID: "execution", Slot: "agent"}
+			path, err := preparePath(t.Context(), st, spec)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := gitutil.AddWorktree(t.Context(), repo, path, "HEAD"); err != nil {
+				t.Fatal(err)
+			}
+			if err := worktreeplacement.Created(t.Context(), st, path); err != nil {
+				t.Fatal(err)
+			}
+			sibling := filepath.Join(filepath.Dir(path), "operator-note")
+			if err := os.WriteFile(sibling, []byte("keep"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := worktreeplacement.Remove(t.Context(), st, repo, path); err != nil {
+				t.Fatal(err)
+			}
+			if body, err := os.ReadFile(sibling); err != nil || string(body) != "keep" {
+				t.Fatalf("unowned sibling changed: %q %v", body, err)
+			}
+			for _, removed := range []string{path, path + ".reservation"} {
+				if _, err := os.Stat(removed); !os.IsNotExist(err) {
+					t.Fatalf("owned path remains: %s %v", removed, err)
+				}
+			}
+		})
+	}
+}
+
+func TestReviewLayoutRejectsNonLeafRepositoryName(t *testing.T) {
+	for _, identity := range []string{".", "..", string(filepath.Separator)} {
+		t.Run(identity, func(t *testing.T) {
+			spec := worktreeplacement.Spec{Root: t.TempDir(), SourceRepo: repository(t), RepoIdentity: identity, Kind: "review", OwnerID: "owner", ExecutionID: "execution", Slot: "agent"}
+			if _, err := preparePath(t.Context(), database(t), spec); err == nil {
+				t.Fatal("non-leaf repository name accepted")
+			}
+		})
+	}
+}
