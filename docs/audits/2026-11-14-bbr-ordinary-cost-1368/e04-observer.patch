+++ b/internal/ackhandler/bbr_observer_test.go
@@ -0,0 +1,52 @@
+package ackhandler
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBBRObservationACKSamplesAndEarlyACK(t *testing.T) {
+	h, _ := newLocalRichHandler(t)
+	ObserveBBRProgress(h, func() (bool, bool) { return true, false })
+	now := monotime.Now()
+	pn, token := localRichPacket(t, h, now)
+	require.NoError(t, h.CompleteLocalPacket(token, LocalPacketAccepted, now.Add(time.Millisecond)))
+	require.Zero(t, h.BBRObservation().Counters.ACKEvents, "E02 empty completion is not an invalid ACK sample")
+	acknowledgeRecoveryPacket(t, h, protocol.EncryptionInitial, now.Add(10*time.Millisecond), pn)
+	before := h.BBRObservation()
+	require.EqualValues(t, 1, before.Counters.ValidSamples)
+	require.Zero(t, before.Counters.InvalidSamples)
+	require.EqualValues(t, 1200, before.Counters.DeliveredBytes)
+	require.EqualValues(t, 1, before.Counters.FirstLocalACKs)
+	require.Zero(t, before.Counters.EarlyACKs)
+
+	early, earlyToken := localRichPacket(t, h, now.Add(20*time.Millisecond))
+	acknowledgeRecoveryPacket(t, h, protocol.EncryptionInitial, now.Add(30*time.Millisecond), early)
+	observed := h.BBRObservation()
+	require.EqualValues(t, 2, observed.Counters.ACKEvents)
+	require.EqualValues(t, 1, observed.Counters.InvalidSamples)
+	require.EqualValues(t, 1, observed.Counters.UnanchoredSamples)
+	require.EqualValues(t, 2, observed.Counters.FirstLocalACKs)
+	require.EqualValues(t, 1, observed.Counters.EarlyACKs)
+	require.EqualValues(t, 1, observed.Counters.EarlyACKWithParticipantHint)
+	require.Zero(t, observed.Counters.EarlyACKWithDeferredFacts)
+	require.EqualValues(t, 1, observed.Counters.TimingExcludedPackets)
+	require.Positive(t, observed.Counters.TimingFences)
+	require.EqualValues(t, 2400, observed.Counters.DeliveredBytes)
+
+	acknowledgeRecoveryPacket(t, h, protocol.EncryptionInitial, now.Add(31*time.Millisecond), early)
+	require.NoError(t, h.CompleteLocalPacket(earlyToken, LocalPacketAccepted, now.Add(32*time.Millisecond)))
+	require.Equal(t, observed.Counters.FirstLocalACKs, h.BBRObservation().Counters.FirstLocalACKs)
+	require.Equal(t, observed.Counters.EarlyACKs, h.BBRObservation().Counters.EarlyACKs)
+	h.resetCongestionCapture(false)
+	reset := h.BBRObservation()
+	require.Equal(t, observed.Counters.TimingFences, reset.Counters.TimingFences, "fence total survives sampler replacement")
+	require.EqualValues(t, 1, reset.Counters.SamplerResets)
+	require.Equal(t, observed.Counters.EarlyACKs, reset.Counters.EarlyACKs)
+	h.CloseDelivery()
+	require.Equal(t, reset.Counters, h.BBRObservation().Counters)
+}
