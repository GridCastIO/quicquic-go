+//go:build darwin || linux || freebsd
+
+package quic
+
+import (
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/wire"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBBRObserverNativeReturnAndConsumption(t *testing.T) {
+	nativeOrdinaryTest(t, func(t *testing.T) {
+		tc, sender, socket := nativeProbeRecoveryConnection(t, "bbrv3")
+		socket.result = func(data []byte) (int, error) {
+			time.Sleep(25 * time.Microsecond)
+			return len(data), nil
+		}
+		require.NoError(t, tc.conn.datagramQueue.Add(&wire.DatagramFrame{DataLenPresent: true, Data: []byte("observe native return")}))
+		result := tc.conn.emission.send(monotime.Now(), true)
+		require.NoError(t, result.err)
+		require.True(t, result.progress)
+		time.Sleep(100 * time.Microsecond)
+		synctest.Wait()
+		require.Len(t, socket.writes, 1)
+		for range 2 {
+			hint, deferred := sender.bbrProgressHint()
+			require.True(t, hint, "observing a hint must not consume it")
+			require.False(t, deferred)
+		}
+		require.NoError(t, sender.consume())
+		o := sender.bbrNativeObservation()
+		require.EqualValues(t, 1, o.ConsumeClockReads)
+		require.EqualValues(t, 1, o.Members)
+		require.EqualValues(t, 1, o.AcceptedMembers)
+		require.EqualValues(t, 1, o.Datagrams)
+		require.EqualValues(t, 1, o.AcceptedDatagrams)
+		require.EqualValues(t, len(socket.writes[0].data), o.MemberBytes)
+		require.Equal(t, o.MemberBytes, o.AcceptedBytes)
+		require.EqualValues(t, 25*time.Microsecond, o.OpportunityToReturn.Nanoseconds)
+		require.EqualValues(t, 75*time.Microsecond, o.ReturnToConsume.Nanoseconds)
+		require.EqualValues(t, 1, o.OpportunityToReturn.Count)
+		require.EqualValues(t, 1, o.ReturnToConsume.Count)
+		require.Zero(t, o.OpportunityToReturn.Missing)
+		require.Zero(t, o.ReturnToConsume.Negative)
+		require.NoError(t, sender.consume())
+		require.Equal(t, o, sender.bbrNativeObservation(), "empty consumption does not duplicate observations")
+	})
+}
