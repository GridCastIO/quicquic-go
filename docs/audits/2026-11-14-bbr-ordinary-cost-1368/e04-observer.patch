+package quic
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBBRObservationBoundedSnapshotsAndFreeze(t *testing.T) {
+	now := monotime.Now()
+	c := &Conn{}
+	c.traceBBR(now)
+	require.Nil(t, c.bbrObservation, "Reno creates no snapshot storage")
+	p := newBBRSendPolicy(1000000, 1200, now)
+	p.controller = congestion.NewBBRSender(1200)
+	c.emission.bbr = p
+	model := p.controller.Observation()
+	c.traceBBR(now)
+	require.Nil(t, c.qlogger, "observer never enables qlog")
+	require.Equal(t, 1, c.bbrObservation.SnapshotCount)
+	c.traceBBR(now.Add(time.Second / 2))
+	require.Equal(t, 1, c.bbrObservation.SnapshotCount)
+	for i := 1; i < bbrObservationSnapshots+3; i++ {
+		c.traceBBR(now.Add(time.Duration(i) * time.Second))
+	}
+	require.Equal(t, bbrObservationSnapshots, c.bbrObservation.SnapshotCount)
+	require.EqualValues(t, 3, c.bbrObservation.Overflow)
+	require.Equal(t, now.ToTime().UnixNano(), c.bbrObservation.Snapshots[0].UnixNS)
+	require.Equal(t, model, p.controller.Observation(), "snapshotting changes no model facts")
+	c.freezeBBRObservation()
+	final := c.bbrObservation.Final
+	require.True(t, c.bbrObservation.FinalRecorded)
+	p.rate++
+	c.freezeBBRObservation()
+	c.traceBBR(now.Add(time.Hour))
+	require.Equal(t, final, c.bbrObservation.Final, "frozen final evidence cannot be overwritten during teardown")
+	require.EqualValues(t, 3, c.bbrObservation.Overflow)
+}
