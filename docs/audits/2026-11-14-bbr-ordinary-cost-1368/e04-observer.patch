--- /dev/null
+++ b/internal/congestion/bbr_observer_test.go
@@ -0,0 +1,31 @@
+package congestion
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBBRObservationModelRejectionAndReset(t *testing.T) {
+	b := NewBBRSender(1200)
+	feedbackRound(b, 1, 1200, 100000, SendUnknown, 20000)
+	require.EqualValues(t, 1, b.Observation().Counters.ModelUsableSamples)
+	feedbackRound(b, 0, 2400, 100000, SendUnknown, 20000)
+	o := b.Observation()
+	require.EqualValues(t, 2, o.Counters.ACKEvents)
+	require.EqualValues(t, 1, o.Counters.ACKClockRejected)
+	require.EqualValues(t, 1, o.Counters.ModelUsableSamples)
+	require.Equal(t, b.PacingRate(), o.PacingRate)
+	require.Equal(t, b.DeliveryRateEstimate(), o.DeliveryRate)
+	b.Feedback(FeedbackEvent{Time: monotime.Time(time.Nanosecond)})
+	require.EqualValues(t, 2, b.Observation().Counters.ClockRejected)
+	require.EqualValues(t, 1, b.Observation().Counters.ACKClockRejected)
+	b.Reset(1, 1, 2400)
+	require.EqualValues(t, 1, b.Observation().Counters.Resets)
+	require.EqualValues(t, 1, b.Observation().Counters.ModelUsableSamples)
+	b.Close()
+	require.EqualValues(t, 1, b.Observation().Counters.Closes)
+	require.EqualValues(t, 1, b.Observation().Counters.ModelUsableSamples)
+}
