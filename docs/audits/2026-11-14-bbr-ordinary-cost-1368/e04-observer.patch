diff --git a/bbr_observer.go b/bbr_observer.go
new file mode 100644
index 000000000..f5649329f
--- /dev/null
+++ b/bbr_observer.go
@@ -0,0 +1,84 @@
+package quic
+
+import (
+	"time"
+
+	"github.com/quic-go/quic-go/internal/ackhandler"
+	"github.com/quic-go/quic-go/internal/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+)
+
+const bbrObservationSnapshots = 128
+
+type bbrConnectionSnapshot struct {
+	MonoNS     int64                             `json:"mono_ns"`
+	UnixNS     int64                             `json:"unix_ns"`
+	PacingRate uint64                            `json:"effective_pacing_rate"`
+	Quantum    int64                             `json:"quantum"`
+	Pending    int64                             `json:"pending_bytes"`
+	Current    int64                             `json:"current_pending_bytes"`
+	Model      congestion.BBRModelObservation    `json:"model"`
+	Recovery   ackhandler.BBRRecoveryObservation `json:"recovery"`
+	Emission   bbrEmissionObservation            `json:"emission"`
+	Native     BBRNativeObservation              `json:"native"`
+}
+
+// E04 measurement-only storage. The connection owns it until Context completion.
+// Cadence follows send opportunities: inactive intervals produce no observations.
+// Snapshots are cumulative lifetime evidence, not exact fixture-window counts.
+type bbrConnectionObservation struct {
+	Snapshots     [bbrObservationSnapshots]bbrConnectionSnapshot `json:"snapshots"`
+	SnapshotCount int                                            `json:"snapshot_count"`
+	Overflow      uint64                                         `json:"snapshot_overflow"`
+	Final         bbrConnectionSnapshot                          `json:"final_before_teardown"`
+	FinalRecorded bool                                           `json:"final_recorded"`
+	last          monotime.Time
+}
+
+func (c *Conn) bbrObservationSnapshot(now monotime.Time) bbrConnectionSnapshot {
+	e := &c.emission
+	p := e.bbr
+	r := bbrConnectionSnapshot{MonoNS: int64(now), UnixNS: now.ToTime().UnixNano(), PacingRate: p.rate, Quantum: int64(p.quantum), Model: p.controller.Observation(), Emission: e.observer}
+	p.credit.mu.Lock()
+	r.Pending, r.Current = int64(p.credit.pending), int64(p.credit.current)
+	p.credit.mu.Unlock()
+	if h, ok := c.sentPacketHandler.(interface {
+		BBRObservation() ackhandler.BBRRecoveryObservation
+	}); ok {
+		r.Recovery = h.BBRObservation()
+	}
+	if local, ok := e.local.(interface{ bbrNativeObservation() BBRNativeObservation }); ok {
+		r.Native = local.bbrNativeObservation()
+	}
+	return r
+}
+
+func (c *Conn) observeBBR(now monotime.Time) {
+	p := c.emission.bbr
+	if p == nil || p.controller == nil {
+		return
+	}
+	if c.bbrObservation == nil {
+		c.bbrObservation = new(bbrConnectionObservation)
+	}
+	o := c.bbrObservation
+	if o.FinalRecorded || (!o.last.IsZero() && now.Sub(o.last) < time.Second) {
+		return
+	}
+	o.last = now
+	if o.SnapshotCount == len(o.Snapshots) {
+		o.Overflow++
+		return
+	}
+	o.Snapshots[o.SnapshotCount] = c.bbrObservationSnapshot(now)
+	o.SnapshotCount++
+}
+
+func (c *Conn) freezeBBRObservation() {
+	if c.bbrObservation != nil && !c.bbrObservation.FinalRecorded {
+		// One final observation clock, never a per-packet clock. Freeze before
+		// lifecycle teardown clears the controller and delivery sampler.
+		c.bbrObservation.Final = c.bbrObservationSnapshot(monotime.Now())
+		c.bbrObservation.FinalRecorded = true
+	}
+}
diff --git a/bbr_observer_emission.go b/bbr_observer_emission.go
new file mode 100644
index 000000000..0f0eac25c
--- /dev/null
+++ b/bbr_observer_emission.go
@@ -0,0 +1,170 @@
+package quic
+
+import (
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+// E04 observer for #1368. These connection-owned scalars never govern sending.
+// Retry intervals span the first refusal to the next ordinary reservation, so
+// they include intervening protocol work and are not pure credit-wait time.
+// EndpointCapacityRefusals counts native sender WouldBlock results, including
+// registration/sidecar capacity; it does not prove the endpoint mailbox is full.
+type bbrEmissionObservation struct {
+	OrdinaryAttempts, OrdinarySuccesses, OrdinaryRefusals                        uint64
+	OrdinaryRequestedBytes, OrdinaryReservedBytes                                uint64
+	Handoffs, HandoffBytes, HandoffDatagrams                                     uint64
+	RefusedRequestedBytes, RefusedPendingBytes, RefusedFreeBytes                 int64
+	RefusedMaxRequestedBytes, RefusedMaxPendingBytes, RefusedMaxFreeBytes        int64
+	RefusedWithPacketRoom, RefusedUsablePartialRoom                              uint64
+	RefusedOldGeneration, RefusedIsolated                                        uint64
+	RetryIntervals, RetryNanoseconds, RetryMaxNanoseconds, RetryClockRegressions uint64
+	RetryOpen                                                                    bool
+	QueueCapacityChecks, QueueCapacityRefusals, EndpointCapacityRefusals         uint64
+	Opportunities, Progress, SupplyExhausted, Errors                             uint64
+	NoData, QueueFull, HardBlocked, Paced, ReceivePending                        uint64
+	CongestionLimited, ProbePending, SendAny, ProbeSent                          uint64
+	DefaultStopWithProgress                                                      uint64
+	retryStartedAt                                                               monotime.Time
+}
+
+// reserve observes the exact state under localSendCredit.mu. Only the connection
+// calls this method; the worker owns no observation pointer.
+func (o *bbrEmissionObservation) reserve(c *localSendCredit, requested, limit, size protocol.ByteCount, accepted bool, now monotime.Time) {
+	o.OrdinaryAttempts++
+	o.OrdinaryRequestedBytes += uint64(requested)
+	if accepted {
+		o.OrdinarySuccesses++
+		o.OrdinaryReservedBytes += uint64(requested)
+		if o.RetryOpen {
+			if now.Before(o.retryStartedAt) {
+				o.RetryClockRegressions++
+			} else {
+				delay := uint64(now.Sub(o.retryStartedAt))
+				o.RetryIntervals++
+				o.RetryNanoseconds += delay
+				o.RetryMaxNanoseconds = max(o.RetryMaxNanoseconds, delay)
+			}
+			o.RetryOpen, o.retryStartedAt = false, 0
+		}
+		return
+	}
+	o.OrdinaryRefusals++
+	free := max(0, limit-c.pending)
+	o.RefusedRequestedBytes += int64(requested)
+	o.RefusedPendingBytes += int64(c.pending)
+	o.RefusedFreeBytes += int64(free)
+	o.RefusedMaxRequestedBytes = max(o.RefusedMaxRequestedBytes, int64(requested))
+	o.RefusedMaxPendingBytes = max(o.RefusedMaxPendingBytes, int64(c.pending))
+	o.RefusedMaxFreeBytes = max(o.RefusedMaxFreeBytes, int64(free))
+	if free >= size {
+		o.RefusedWithPacketRoom++
+		if !c.isolated && c.pending == c.current && requested > free {
+			o.RefusedUsablePartialRoom++
+		}
+	}
+	if c.pending != c.current {
+		o.RefusedOldGeneration++
+	}
+	if c.isolated {
+		o.RefusedIsolated++
+	}
+	if !o.RetryOpen {
+		o.RetryOpen, o.retryStartedAt = true, now
+	}
+}
+
+func (e *packetEmission) observedQueueWouldBlock() bool {
+	blocked := e.queue.WouldBlock()
+	if e.bbr != nil {
+		e.observer.QueueCapacityChecks++
+		if blocked {
+			e.observer.QueueCapacityRefusals++
+			if e.local != nil {
+				e.observer.EndpointCapacityRefusals++
+			}
+		}
+	}
+	return blocked
+}
+
+func (o *bbrEmissionObservation) result(r emissionResult) {
+	o.Opportunities++
+	if r.progress {
+		o.Progress++
+	}
+	if r.supplyExhausted {
+		o.SupplyExhausted++
+	}
+	if r.err != nil {
+		o.Errors++
+	}
+	switch r.stop {
+	case emissionNoData:
+		if r.progress {
+			// Ordinary successful handoffs leave the zero-valued stop unchanged.
+			o.DefaultStopWithProgress++
+		} else {
+			o.NoData++
+		}
+	case emissionQueueFull:
+		o.QueueFull++
+	case emissionHardBlocked:
+		o.HardBlocked++
+	case emissionPaced:
+		o.Paced++
+	case emissionReceivePending:
+		o.ReceivePending++
+	case emissionCongestionLimited:
+		o.CongestionLimited++
+	case emissionProbePending:
+		o.ProbePending++
+	case emissionSendAny:
+		o.SendAny++
+	case emissionProbeSent:
+		o.ProbeSent++
+	}
+}
+
+// BBRNativeObservation is a value snapshot, written and copied only on the
+// connection. OpportunityToReturn starts at the batch's existing reservation
+// timestamp (also the ordinary packets' registration timestamp), not handoff.
+// ReturnToConsume includes endpoint reconciliation and connection scheduling.
+// AcceptedBytes counts only fully accepted members; AcceptedDatagrams also
+// includes a partial member's accepted prefix without guessing its byte count.
+type BBRNativeObservation struct {
+	Members, AcceptedMembers, AcceptedBytes, ConsumeClockReads uint64
+	MemberBytes, Datagrams, AcceptedDatagrams                  uint64
+	OpportunityToReturn, ReturnToConsume                       bbrDurationObservation
+}
+
+// Buckets have inclusive upper bounds of 10, 25, 50, 100, 250, 500 and 1000
+// microseconds, followed by +Inf. Missing and backwards timestamps are excluded.
+type bbrDurationObservation struct {
+	Count, Nanoseconds, MaxNanoseconds, Missing, Negative uint64
+	Buckets                                               [8]uint64
+}
+
+func (o *bbrDurationObservation) interval(start, end monotime.Time) {
+	if start.IsZero() || end.IsZero() {
+		o.Missing++
+		return
+	}
+	if end.Before(start) {
+		o.Negative++
+		return
+	}
+	d := end.Sub(start)
+	o.Count++
+	o.Nanoseconds += uint64(d)
+	o.MaxNanoseconds = max(o.MaxNanoseconds, uint64(d))
+	for i, bound := range [...]time.Duration{10, 25, 50, 100, 250, 500, 1000} {
+		if d <= bound*time.Microsecond {
+			o.Buckets[i]++
+			return
+		}
+	}
+	o.Buckets[len(o.Buckets)-1]++
+}
