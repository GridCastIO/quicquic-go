+package quic
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/wire"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBBRObserverPartialCreditRetry(t *testing.T) {
+	c := newEmissionTestConnection(t, true).conn
+	now := monotime.Now()
+	c.emission.bbr = newBBRSendPolicy(1_000_000, 1200, now)
+	held := c.emission.bbr.credit.reserve(3000, 4800, true, false)
+	require.NotNil(t, held)
+	t.Cleanup(func() {
+		if held != nil {
+			held.complete()
+		}
+	})
+	require.NoError(t, c.datagramQueue.Add(&wire.DatagramFrame{DataLenPresent: true, Data: []byte("wait for the full reservation")}))
+	for _, at := range []monotime.Time{now, now.Add(25 * time.Microsecond)} {
+		result := c.triggerSending(at)
+		require.NoError(t, result.err)
+		require.False(t, result.progress)
+		require.Equal(t, emissionQueueFull, result.stop)
+		require.NotNil(t, c.datagramQueue.Peek(), "observation does not admit a smaller batch")
+	}
+	o := c.emission.observer
+	require.EqualValues(t, 2, o.OrdinaryRefusals)
+	require.EqualValues(t, 2, o.RefusedWithPacketRoom)
+	require.EqualValues(t, 2, o.RefusedUsablePartialRoom)
+	require.EqualValues(t, 4800, o.RefusedRequestedBytes)
+	require.EqualValues(t, 6000, o.RefusedPendingBytes)
+	require.EqualValues(t, 3600, o.RefusedFreeBytes)
+	require.True(t, o.RetryOpen)
+	require.Zero(t, o.RetryIntervals)
+	require.Zero(t, o.QueueCapacityRefusals, "ordinary credit is distinct from queue capacity")
+	held.complete()
+	held = nil
+	result := c.triggerSending(now.Add(100 * time.Microsecond))
+	require.NoError(t, result.err)
+	require.True(t, result.progress)
+	entry := <-c.emission.queue.(*sendQueue).queue
+	defer entry.release()
+	o = c.emission.observer
+	require.EqualValues(t, 3, o.OrdinaryAttempts)
+	require.EqualValues(t, 1, o.OrdinarySuccesses)
+	require.EqualValues(t, 7200, o.OrdinaryRequestedBytes)
+	require.EqualValues(t, 2400, o.OrdinaryReservedBytes)
+	require.EqualValues(t, 1, o.RetryIntervals)
+	require.EqualValues(t, 100*time.Microsecond, o.RetryNanoseconds)
+	require.Equal(t, o.RetryNanoseconds, o.RetryMaxNanoseconds)
+	require.False(t, o.RetryOpen)
+	require.EqualValues(t, 1, o.Handoffs)
+	require.EqualValues(t, entry.buf.Len(), o.HandoffBytes)
+	require.EqualValues(t, 1, o.HandoffDatagrams)
+}
+
+func TestBBRObserverGenerationDebtIsNotUsablePartialRoom(t *testing.T) {
+	c := newLocalSendCredit()
+	held := c.reserve(1200, 4800, true, false)
+	require.NotNil(t, held)
+	defer held.complete()
+	c.resetGeneration(1)
+	var o bbrEmissionObservation
+	require.Nil(t, c.reserveObserved(2400, 4800, true, false, &o, protocol.ByteCount(1200), monotime.Now()))
+	require.EqualValues(t, 1, o.RefusedWithPacketRoom)
+	require.EqualValues(t, 1, o.RefusedOldGeneration)
+	require.Zero(t, o.RefusedUsablePartialRoom)
+}
+
+func TestBBRObserverInvalidTimingIsVisible(t *testing.T) {
+	var o bbrDurationObservation
+	now := monotime.Now()
+	o.interval(0, now)
+	o.interval(now, now.Add(-time.Microsecond))
+	o.interval(now, now.Add(25*time.Microsecond))
+	require.EqualValues(t, 1, o.Missing)
+	require.EqualValues(t, 1, o.Negative)
+	require.EqualValues(t, 1, o.Count)
+	require.EqualValues(t, 25*time.Microsecond, o.Nanoseconds)
+	require.Equal(t, [8]uint64{0, 1}, o.Buckets)
+}
