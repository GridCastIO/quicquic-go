+++ b/internal/congestion/bbr_observer.go
@@ -0,0 +1,38 @@
+package congestion
+
+// E04 measurement-only counters remain outside resettable model facts.
+type BBRModelCounters struct {
+	FeedbackEvents     uint64 `json:"feedback_events"`
+	ACKEvents          uint64 `json:"ack_events"`
+	ClockRejected      uint64 `json:"clock_rejected"`
+	ACKClockRejected   uint64 `json:"ack_clock_rejected"`
+	ModelUsableSamples uint64 `json:"model_usable_samples"`
+	Resets             uint64 `json:"resets"`
+	Closes             uint64 `json:"closes"`
+}
+
+type BBRModelObservation struct {
+	Counters       BBRModelCounters `json:"counters"`
+	Phase          string           `json:"phase"`
+	PacingRate     uint64           `json:"pacing_rate"`
+	DeliveryRate   uint64           `json:"delivery_rate"`
+	Bandwidth      uint64           `json:"bandwidth"`
+	BandwidthShort uint64           `json:"bandwidth_short"`
+	Window         int64            `json:"window"`
+	MinRTTNS       int64            `json:"min_rtt_ns"`
+	Round          uint64           `json:"round"`
+	CEActive       bool             `json:"ce_active"`
+	CERate         uint64           `json:"ce_rate"`
+	InRecovery     bool             `json:"in_recovery"`
+}
+
+func (b *BBRSender) Observation() BBRModelObservation {
+	return BBRModelObservation{
+		Counters:   b.observation,
+		Phase:      [...]string{"Startup", "Drain", "Down", "Cruise", "Refill", "Up", "ProbeRTT"}[b.phase],
+		PacingRate: b.PacingRate(), DeliveryRate: b.DeliveryRateEstimate(),
+		Bandwidth: b.bandwidth, BandwidthShort: b.bandwidthShort,
+		Window: int64(b.window), MinRTTNS: int64(b.minimumRTT), Round: b.round,
+		CEActive: b.ce.active, CERate: b.ce.rate, InRecovery: b.InRecovery(),
+	}
+}
