diff --git a/internal/ackhandler/local_member_observer.go b/internal/ackhandler/local_member_observer.go
new file mode 100644
index 000000000..450a4f091
--- /dev/null
+++ b/internal/ackhandler/local_member_observer.go
@@ -0,0 +1,87 @@
+package ackhandler
+
+import "github.com/quic-go/quic-go/internal/monotime"
+
+// LocalMemberCount is E10-only cumulative connection-owned evidence.
+type LocalMemberCount struct {
+	Members uint64 `json:"members"`
+	Packets uint64 `json:"packets"`
+}
+
+func (c *LocalMemberCount) add(packets int) {
+	c.Members++
+	c.Packets += uint64(packets)
+}
+
+// LocalMemberDecline identifies the first failed predicate, in source order.
+type LocalMemberDecline uint8
+
+const (
+	MemberHandler LocalMemberDecline = iota
+	MemberShape
+	MemberLocalState
+	MemberQlog
+	MemberHandshake
+	MemberAmplification
+	MemberLostQueue
+	MemberRichController
+	MemberUnexpectedBBRECN
+	MemberPTO
+	MemberPhysicalPrefix
+	MemberPendingECN
+	MemberECNConstraints
+	MemberECNTracker
+	MemberTokenOwner
+	MemberTokenLevel
+	MemberTokenOutcome
+	MemberTokenAcked
+	MemberTokenEarlyACK
+	MemberTokenOrder
+	MemberTokenTime
+	MemberPacketState
+	MemberHistoryIdentity
+	MemberRichSize
+	MemberRichTiming
+	MemberRichOrdinal
+	MemberRichDelivery
+	MemberRichDeliveryOrdinal
+	MemberRichGeneration
+	MemberRichRecovery
+	MemberRichRecoveryOrdinal
+	MemberRichRecoveryState
+	MemberRichRegistration
+	MemberDeclineCount
+)
+
+// LocalMemberObservation has no references to live recovery state. The caller
+// owns it, and only lends its address for one synchronous E10 observation.
+type LocalMemberObservation struct {
+	Attempts      LocalMemberCount                     `json:"attempts"`
+	RichAttempts  LocalMemberCount                     `json:"rich_attempts"`
+	Successes     LocalMemberCount                     `json:"successes"`
+	RichSuccesses LocalMemberCount                     `json:"rich_successes"`
+	Declines      [MemberDeclineCount]LocalMemberCount `json:"declines"`
+}
+
+func (o *LocalMemberObservation) decline(reason LocalMemberDecline, packets int) bool {
+	if o != nil {
+		o.Declines[reason].add(packets)
+	}
+	return false
+}
+
+func (o *LocalMemberObservation) success(packets int, rich bool) bool {
+	if o != nil {
+		o.Successes.add(packets)
+		if rich {
+			o.RichSuccesses.add(packets)
+		}
+	}
+	return true
+}
+
+// ObserveCompleteLocalAcceptedPackets is disposable E10 instrumentation of the
+// same decision, not another preflight or a completion owner. o is never retained.
+func ObserveCompleteLocalAcceptedPackets(handler LocalSentPacketHandler, tokens []LocalCompletionToken, returnedAt monotime.Time, o *LocalMemberObservation) bool {
+	return tryCompleteLocalAcceptedPackets(handler, tokens, returnedAt, o)
+}
diff --git a/internal/ackhandler/local_member_observer_test.go b/internal/ackhandler/local_member_observer_test.go
new file mode 100644
index 000000000..1fa6cd2b7
--- /dev/null
+++ b/internal/ackhandler/local_member_observer_test.go
@@ -0,0 +1,112 @@
+package ackhandler
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/stretchr/testify/require"
+)
+
+func requireMemberObservationConserved(t *testing.T, o LocalMemberObservation) {
+	t.Helper()
+	all, rich := o.Successes, o.RichSuccesses
+	for reason, count := range o.Declines {
+		all.Members += count.Members
+		all.Packets += count.Packets
+		if reason >= int(MemberRichSize) {
+			rich.Members += count.Members
+			rich.Packets += count.Packets
+		}
+	}
+	require.Equal(t, o.Attempts, all)
+	require.Equal(t, o.RichAttempts, rich)
+}
+
+func TestE10MemberObservationPreservesCompletion(t *testing.T) {
+	var o LocalMemberObservation
+	for _, count := range []int{2, 64} {
+		observed, or, tokens, at := newLocalBBRMemberTest(t, count, "capable")
+		plain, pr, reference, _ := newLocalBBRMemberTest(t, count, "capable")
+		require.True(t, ObserveCompleteLocalAcceptedPackets(observed, tokens, at, &o))
+		require.True(t, TryCompleteLocalAcceptedPackets(plain, reference, at))
+		requireLocalBBRMemberEquivalent(t, plain, observed, pr, or)
+		ackLocalBBRMemberTest(t, observed, at.Add(time.Millisecond))
+		ackLocalBBRMemberTest(t, plain, at.Add(time.Millisecond))
+		requireLocalBBRMemberEquivalent(t, plain, observed, pr, or)
+	}
+	want := LocalMemberCount{Members: 2, Packets: 66}
+	require.Equal(t, want, o.Attempts)
+	require.Equal(t, want, o.RichAttempts)
+	require.Equal(t, want, o.Successes)
+	require.Equal(t, want, o.RichSuccesses)
+	requireMemberObservationConserved(t, o)
+	// Counters belong to the caller, so replacing recovery doesn't reset them.
+	reno, tokens := newLocalSpanTest(t, false)
+	require.True(t, ObserveCompleteLocalAcceptedPackets(reno, tokens, monotime.Time(time.Second+time.Millisecond), &o))
+	require.Equal(t, LocalMemberCount{Members: 3, Packets: 69}, o.Successes)
+	require.Equal(t, want, o.RichSuccesses)
+	requireMemberObservationConserved(t, o)
+}
+
+func TestE10MemberObservationFirstDecline(t *testing.T) {
+	for _, reason := range []LocalMemberDecline{MemberHandler, MemberPTO, MemberPhysicalPrefix, MemberPendingECN, MemberTokenOwner, MemberTokenEarlyACK, MemberRichSize, MemberRichTiming, MemberRichDelivery, MemberRichGeneration, MemberRichRegistration} {
+		t.Run(string(rune('A'+reason)), func(t *testing.T) {
+			count := 3
+			if reason == MemberRichSize {
+				count = 65
+			}
+			h, recorder, tokens, at := newLocalBBRMemberTest(t, count, "capable")
+			var handler LocalSentPacketHandler = h
+			d := h.congestionEvents
+			last := tokens[len(tokens)-1].registration
+			key := congestionKey(last.level, last.pn)
+			switch reason {
+			case MemberHandler:
+				handler = nil
+			case MemberPTO:
+				h.appDataPackets.history.localPTOTracked = false
+			case MemberPhysicalPrefix:
+				h.appDataPackets.largestAcked = h.appDataPackets.history.LowestPacketNumber()
+				h.local.ecn.pending = true // later common failure must not win
+			case MemberPendingECN:
+				h.local.ecn.pending = true
+				h.local.ecn.constraints = []localECNConstraint{{frontier: last.pn}}
+			case MemberTokenOwner:
+				_, _, foreign, _ := newLocalBBRMemberTest(t, 2, "capable")
+				foreign[1].registration.earlyACK = true
+				tokens[len(tokens)-1] = foreign[1]
+			case MemberTokenEarlyACK:
+				last.earlyACK, last.timingMissing = true, true
+			case MemberRichTiming:
+				last.timingMissing = true
+				d.packets.delete(key) // timing is the first rich failure
+			case MemberRichDelivery:
+				d.packets.delete(key)
+			case MemberRichGeneration:
+				d.packets.borrow(key).PathGeneration++
+			case MemberRichRegistration:
+				d.recovery.local.outcomes[d.recovery.find(key)].registration = nil
+			}
+			owner, event, alarm := h.local.owner, d.event, h.GetLossDetectionTimeout()
+			feedback, cursor := len(recorder.feedback), d.recovery.local.qualifiedOrdinal
+			var o LocalMemberObservation
+			require.False(t, ObserveCompleteLocalAcceptedPackets(handler, tokens, at, &o))
+			want := LocalMemberCount{Members: 1, Packets: uint64(count)}
+			require.Equal(t, want, o.Attempts)
+			require.Equal(t, want, o.Declines[reason])
+			if reason >= MemberRichSize {
+				require.Equal(t, want, o.RichAttempts)
+			} else {
+				require.Zero(t, o.RichAttempts)
+			}
+			requireMemberObservationConserved(t, o)
+			require.Equal(t, owner, h.local.owner)
+			require.Equal(t, event, d.event)
+			require.Equal(t, alarm, h.GetLossDetectionTimeout())
+			require.Len(t, recorder.feedback, feedback)
+			require.Equal(t, cursor, d.recovery.local.qualifiedOrdinal)
+			require.False(t, ObserveCompleteLocalAcceptedPackets(handler, tokens, at, nil))
+		})
+	}
+}
