diff --git a/bbr_member_observer.go b/bbr_member_observer.go
new file mode 100644
index 000000000..7b0d00e14
--- /dev/null
+++ b/bbr_member_observer.go
@@ -0,0 +1,132 @@
+package quic
+
+import (
+	"time"
+
+	"github.com/quic-go/quic-go/internal/ackhandler"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+const bbrObservationSnapshots = 128
+
+type bbrMemberCount struct {
+	Members uint64 `json:"members"`
+	Packets uint64 `json:"packets"`
+}
+
+func (c *bbrMemberCount) add(packets int) {
+	c.Members++
+	c.Packets += uint64(packets)
+}
+
+const (
+	bbrMemberResultError = iota
+	bbrMemberPartial
+	bbrMemberPacketGeometry
+	bbrMemberTooSmall
+	bbrMemberTooLarge
+	bbrMemberMTU
+	bbrMemberNativeDeclines
+)
+
+// E10-only evidence, written exclusively by the connection goroutine. Native
+// attempts begin after terminal member accounting validation in consumeResult.
+type bbrNativeMemberObservation struct {
+	Attempts     bbrMemberCount                          `json:"attempts"`
+	Datagrams    uint64                                  `json:"datagrams"`
+	SeamAttempts bbrMemberCount                          `json:"seam_attempts"`
+	Successes    bbrMemberCount                          `json:"successes"`
+	Declines     [bbrMemberNativeDeclines]bbrMemberCount `json:"declines"`
+	Recovery     ackhandler.LocalMemberObservation       `json:"recovery"`
+}
+
+func (o *bbrNativeMemberObservation) decline(reason, packets int) bool {
+	o.Declines[reason].add(packets)
+	return false
+}
+
+type bbrMemberGeometry struct {
+	Handoffs       uint64    `json:"handoffs"`
+	Bytes          uint64    `json:"bytes"`
+	Datagrams      uint64    `json:"datagrams"`
+	GSOHandoffs    uint64    `json:"gso_handoffs"`
+	ScalarHandoffs uint64    `json:"scalar_handoffs"`
+	SizeBuckets    [7]uint64 `json:"size_buckets"`
+}
+
+func (o *bbrMemberGeometry) handoff(size protocol.ByteCount, gso uint16) {
+	o.Handoffs++
+	o.Bytes += uint64(size)
+	if gso == 0 {
+		o.ScalarHandoffs++
+		o.Datagrams++
+	} else {
+		o.GSOHandoffs++
+		o.Datagrams += uint64((size + protocol.ByteCount(gso) - 1) / protocol.ByteCount(gso))
+	}
+	for i, limit := range [...]protocol.ByteCount{1452, 16384, 20480, 32768, 49152, 65507} {
+		if size <= limit {
+			o.SizeBuckets[i]++
+			return
+		}
+	}
+	o.SizeBuckets[6]++
+}
+
+type bbrConnectionSnapshot struct {
+	MonoNS   int64                      `json:"mono_ns"`
+	UnixNS   int64                      `json:"unix_ns"`
+	Geometry bbrMemberGeometry          `json:"geometry"`
+	Native   bbrNativeMemberObservation `json:"native"`
+}
+
+// Fixed by-value snapshots deliberately exclude live model/credit reads. Gaps
+// mean inactive send opportunities, and totals begin before the fixture window.
+type bbrConnectionObservation struct {
+	Snapshots     [bbrObservationSnapshots]bbrConnectionSnapshot `json:"snapshots"`
+	SnapshotCount int                                            `json:"snapshot_count"`
+	Overflow      uint64                                         `json:"snapshot_overflow"`
+	Final         bbrConnectionSnapshot                          `json:"final_before_teardown"`
+	FinalRecorded bool                                           `json:"final_recorded"`
+	last          monotime.Time
+}
+
+func (c *Conn) bbrObservationSnapshot(now monotime.Time) bbrConnectionSnapshot {
+	r := bbrConnectionSnapshot{MonoNS: int64(now), UnixNS: now.ToTime().UnixNano(), Geometry: c.emission.memberGeometry}
+	if local, ok := c.emission.local.(interface {
+		bbrMemberObservation() bbrNativeMemberObservation
+	}); ok {
+		r.Native = local.bbrMemberObservation()
+	}
+	return r
+}
+
+func (c *Conn) observeBBR(now monotime.Time) {
+	p := c.emission.bbr
+	if p == nil || p.controller == nil {
+		return
+	}
+	if c.bbrObservation == nil {
+		c.bbrObservation = new(bbrConnectionObservation)
+	}
+	o := c.bbrObservation
+	if o.FinalRecorded || (!o.last.IsZero() && now.Sub(o.last) < time.Second) {
+		return
+	}
+	o.last = now
+	if o.SnapshotCount == len(o.Snapshots) {
+		o.Overflow++
+		return
+	}
+	o.Snapshots[o.SnapshotCount] = c.bbrObservationSnapshot(now)
+	o.SnapshotCount++
+}
+
+func (c *Conn) freezeBBRObservation() {
+	if c.bbrObservation != nil && !c.bbrObservation.FinalRecorded {
+		// One final clock before teardown; no per-member or per-packet clocks.
+		c.bbrObservation.Final = c.bbrObservationSnapshot(monotime.Now())
+		c.bbrObservation.FinalRecorded = true
+	}
+}
