@@ -0,0 +1,67 @@
+package quic
+
+import (
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go/internal/congestion"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/stretchr/testify/require"
+)
+
+func TestE10MemberGeometryBoundaries(t *testing.T) {
+	for bucket, upper := range [...]protocol.ByteCount{1452, 16384, 20480, 32768, 49152, 65507} {
+		for _, delta := range []protocol.ByteCount{-1, 0, 1} {
+			var o bbrMemberGeometry
+			o.handoff(upper+delta, 0)
+			want := bucket
+			if delta == 1 {
+				want++
+			}
+			require.EqualValues(t, 1, o.Handoffs)
+			require.EqualValues(t, upper+delta, o.Bytes)
+			require.EqualValues(t, 1, o.Datagrams)
+			require.EqualValues(t, 1, o.ScalarHandoffs)
+			require.EqualValues(t, 1, o.SizeBuckets[want])
+		}
+	}
+	var o bbrMemberGeometry
+	o.handoff(2500, 1200)
+	require.EqualValues(t, 3, o.Datagrams, "final short segment remains a datagram")
+	require.EqualValues(t, 1, o.GSOHandoffs)
+	require.EqualValues(t, 1, o.SizeBuckets[1])
+}
+
+func TestE10MemberSnapshotsBoundedAndFrozen(t *testing.T) {
+	now := monotime.Now()
+	c := &Conn{}
+	c.traceBBR(now)
+	require.Nil(t, c.bbrObservation)
+	p := newBBRSendPolicy(1000000, 1200, now)
+	p.controller = congestion.NewBBRSender(1200)
+	c.emission.bbr = p
+	c.emission.memberGeometry.handoff(2500, 1200)
+	c.traceBBR(now)
+	require.Nil(t, c.qlogger)
+	require.Equal(t, 1, c.bbrObservation.SnapshotCount)
+	c.traceBBR(now.Add(time.Second / 2))
+	require.Equal(t, 1, c.bbrObservation.SnapshotCount)
+	first := c.bbrObservation.Snapshots[0]
+	c.emission.memberGeometry.handoff(65507, 1452)
+	for i := 1; i < bbrObservationSnapshots+3; i++ {
+		c.traceBBR(now.Add(time.Duration(i) * time.Second))
+	}
+	require.Equal(t, first, c.bbrObservation.Snapshots[0])
+	require.Equal(t, now.ToTime().UnixNano(), first.UnixNS)
+	require.Equal(t, bbrObservationSnapshots, c.bbrObservation.SnapshotCount)
+	require.EqualValues(t, 3, c.bbrObservation.Overflow)
+	c.freezeBBRObservation()
+	final := c.bbrObservation.Final
+	require.True(t, c.bbrObservation.FinalRecorded)
+	c.emission.memberGeometry.handoff(1, 0)
+	c.freezeBBRObservation()
+	c.traceBBR(now.Add(time.Hour))
+	require.Equal(t, final, c.bbrObservation.Final)
+	require.EqualValues(t, 3, c.bbrObservation.Overflow)
+}
