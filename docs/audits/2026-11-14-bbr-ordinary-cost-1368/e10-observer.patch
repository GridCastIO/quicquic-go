@@ -0,0 +1,53 @@
+//go:build darwin || linux || freebsd
+
+package quic
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/quic-go/quic-go/internal/ackhandler"
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/stretchr/testify/require"
+)
+
+func TestE10NativeMemberDeclines(t *testing.T) {
+	s := &nativeOrdinarySender{}
+	for _, tc := range []struct {
+		packets, datagrams, accepted, reason int
+		err                                  error
+		mtu                                  bool
+	}{
+		{0, 1, 0, bbrMemberResultError, errors.New("write failed"), false},
+		{2, 2, 1, bbrMemberPartial, nil, false},
+		{3, 1, 1, bbrMemberPacketGeometry, nil, false},
+		{1, 1, 1, bbrMemberTooSmall, nil, true},
+		{65, 65, 65, bbrMemberTooLarge, nil, true},
+		{2, 2, 2, bbrMemberMTU, nil, true},
+	} {
+		packets := make([]ordinaryLocalPacket, tc.packets)
+		if tc.mtu {
+			packets[len(packets)-1].mtu = &mtuFinderAckHandler{}
+		}
+		require.False(t, s.completeAcceptedPackets(packets, tc.datagrams, tc.accepted, tc.err, monotime.Now()))
+		require.Equal(t, bbrMemberCount{Members: 1, Packets: uint64(tc.packets)}, s.memberObservation.Declines[tc.reason])
+	}
+	require.Zero(t, s.memberObservation.SeamAttempts)
+	// A native-eligible member reaches the recovery seam once. An unsupported
+	// owner declines there, without a second native decline or foreign read.
+	require.False(t, s.completeAcceptedPackets(make([]ordinaryLocalPacket, 2), 2, 2, nil, monotime.Now()))
+	o := s.memberObservation
+	require.Equal(t, bbrMemberCount{Members: 1, Packets: 2}, o.SeamAttempts)
+	require.Equal(t, ackhandler.LocalMemberCount{Members: 1, Packets: 2}, o.Recovery.Declines[ackhandler.MemberHandler])
+	all := o.SeamAttempts
+	for _, count := range o.Declines {
+		all.Members += count.Members
+		all.Packets += count.Packets
+	}
+	require.Equal(t, all, o.Attempts)
+	c := &Conn{}
+	c.emission.local = s
+	snapshot := c.bbrObservationSnapshot(monotime.Now())
+	s.memberObservation.Recovery.Declines[0].Members++
+	require.Equal(t, o, snapshot.Native, "fixed arrays copy all native and recovery counters")
+}
